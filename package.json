{
  "name": "tier-list-maker-live",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@tier/web",
    "dev:api": "turbo dev --filter=@tier/api",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "turbo db:generate --filter=@tier/db",
    "db:push": "turbo db:push --filter=@tier/db",
    "db:migrate": "turbo db:migrate --filter=@tier/db",
    "db:studio": "turbo db:studio --filter=@tier/db"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "~5.8.2"
  }
}
